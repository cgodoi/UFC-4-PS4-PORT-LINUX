<!-- EA SPORTS UFC 4 (CUSA14204) update 28.00: the engine's own 60 FPS mode.

     The renderer's init (eboot vaddr 0x1274ed0 + 0x400000) sets its present interval to 2:
       0x1274ee5 c7 83 8c 00 00 00 02 00 00 00   mov dword [rbx+0x8c], 2
     The main loop presents every frame with that interval (0x29b57: mov esi, [rbx+0x8c];
     call [vtable+0x168]) -> sceVideoOutSetFlipRate(interval - 1): 2 vblanks per frame, 30 FPS. The
     engine has a 60 FPS path for interval 1 (0x402aca: cmp dword [rax+0x8c], 1 doubles a set of
     render parameters). A second presenter (loading screens) passes an immediate 2:
       0x48715f be 02 00 00 00 ba 04 00 00 00 ...   mov esi, 2; mov edx, 4; ...; call [vtable+0x168]
     Both become 1. Forcing 60 FPS from outside instead (BB_FLIP_RATE=0) made the fight clock run
     fast. Applied by run.sh when the game starts at 60 FPS (the in-game menu's Frame rate, or a
     launcher forcing BB_FLIP_RATE=0). Addresses are vaddr + 0x400000 (patches.py EBOOT_BASE); each
     line has a signature with the original value, so another build matches nowhere. -->
<Patch>
    <TitleID>
        <ID>CUSA14204</ID>
    </TitleID>
    <Metadata Title="EA SPORTS UFC 4"
              Name="60 FPS (engine)"
              Note="The engine's present interval 1 instead of 2: the game runs its own 60 FPS mode."
              Author="cgodoi (UFC-4-PS4-PORT-LINUX)"
              PatchVer="1.0"
              AppVer="28.00"
              AppElf="eboot.bin"
              isEnabled="false">
        <PatchList>
            <Line Type="bytes" Address="0x01674eeb" Value="01"
                  Signature="c7 83 8c 00 00 00 02 00 00 00 a8 12" SignatureOffset="6"/>
            <Line Type="bytes" Address="0x00887160" Value="01"
                  Signature="be 02 00 00 00 ba 04 00 00 00 48 8b 78 20 48 8b 07 ff 90 68 01 00 00" SignatureOffset="1"/>
        </PatchList>
    </Metadata>
</Patch>
